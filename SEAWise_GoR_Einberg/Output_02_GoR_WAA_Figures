#Data file: data
#Year 1960-2020; 
#Two-five. WAA of 2-5 year old herring (g) 
#Ws - winter severity. Winter severity was calculated as a sum of negative daily mean air temperatures from November to March
and assigned to the year of spring (e.g., 1990 winter severity describes the period from November 1989–March 1990).
#Sum - mean daily air temperatures in summer during the main herring feeding period (June-July-August).
#Prey data (ln(ind. m-2)). N - copepod nauplii; E1 - copepodite stages I-III, E2 - copepodite stages IV-V; E3 - adult copepods. 
#e - E. affinis affinis; ea - E. affinis affinis & Acartia spp; l - L. macrurus macrurus. t - small cladocerans 
#e_N - E. affinis affinis mean abundance in May (copepod nauplii); e2_N - in August. 
#No nr - same year; 0 - indicates previous year data (shifted by one year); 1 - shifted one more year back; 2- shifted two years more back and so on. 

library(dplyr)
library(nlme)
library(mgcv)

##############WAA 2 Figure 1
idx = which(data$year %in% c(1962:2020)) #so there would not be years with values NA FOR WAA 2
dat2 = data[idx,]

final = gam(two ~ s(l2_E30, k = 4) + s(e_E3_1, k = 4), data = dat2) #final model WAA 2
quartz(width = 6.8, height = 4)
par(mfrow = c(1, 2), tck = -0.02, mar = c(2.5, 2.7, 1.8, 1), mgp = c(1.3,0.3,0), cex.lab = 1.1, cex.axis = 1)

set2 = data.frame(sort(unique(dat$l2_E30)))
names(set2) = "l2_E30"
set2$e_E3_1 = mean(dat$e_E3_1)
pred = predict(final, newdata = set2, se = T)
plot(two ~ l2_E30, data = dat2, col = 1, pch = 16, cex = 1.1 , xlab = expression(paste("Abundance ln(ind. ",m**-2,")")), ylab = "g" , axes = T)
lines(pred$fit ~ set2$l2_E30)
lines(pred$fit + 2 * pred$se.fit ~ set2$l2_E30, lty = 3)
lines(pred$fit - 2 * pred$se.fit ~ set2$l2_E30, lty = 3)
mtext("a) partial effect of L. macrurus (Aug, adult, A1)", side = 3, line  = 0.2, cex = .8, adj = 0)

set2 = data.frame(sort(dat$e_E3_1))
names(set2) = "e_E3_1"
set2$l2_E30 = mean(dat$l2_E30)
pred = predict(final, newdata = set2, se = T)
plot(two ~ e_E3_1, data = dat2, col = 1, pch = 16, cex = 1.1, xlab = expression(paste("Abundance ln(ind. ",m**-2,")")), ylab = "g" , axes = T)
lines(pred$fit ~ set2$e_E3_1)
lines(pred$fit + 2 * pred$se.fit ~ set2$e_E3_1, lty = 3)
lines(pred$fit - 2 * pred$se.fit ~ set2$e_E3_1, lty = 3)
mtext("b) partial effect of E. affinis (May, adult, A0)", side = 3, line  = 0.2, cex = .8, adj = 0)

