lines(pred$fit + 2 * pred$se.fit ~ set2$e_E20, lty = 3)
lines(pred$fit - 2 * pred$se.fit ~ set2$e_E20, lty = 3)
mtext("b) partial effect of E. affinis (prev. May, IV-V)", side = 3, line  = 0.2, cex = .8, adj = 0)

