abline(v = c(1970,1980,1990,2000,2010), lwd =.5, col = rgb(0,0,0,alpha = 0.5))
par(new = T)
plot(mean_e_E20 ~ cy, axes = F, type = "n", ylab = "", xlab = "", xlim = c(1965,2015))
lines(mean_e_E20 ~ cy, col = grey(0.5), lwd = 2)
axis(4)
mtext("Mean abund. of the window", side = 4, line = 1.3, cex = 1, col = grey(0.5))
mtext("b) Effect of E. affinis affinis (prev. May IV-V)", side = 3, adj = 0, cex = 1, line = 0.2)


