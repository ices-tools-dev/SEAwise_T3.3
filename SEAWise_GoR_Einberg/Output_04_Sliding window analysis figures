#Open file "GoR_growth_2024.RData"

#Data file: w
#Year 1960-2020; SSB (spawning stock biomass, thousand tons), R - age-1 herring abundance (recruitment)
#One-five. WAA of 1-5 year old herring (g)
#x, x1-x4. Mean annual growth (g) of 2-5 year old fish. X1 mean annual growth of ear-old fish, x2 3-year-old fish and so on. 
#Wa - winter severity. Winter severity was calculated as a sum of negative daily mean air temperatures from November to March
#and assigned to the year of spring (e.g., 1990 winter severity describes the period from November 1989–March 1990).
#Sum - mean daily air temperatures in summer during the main herring feeding period (June-July-August).
#Prey data (ln(ind. m-2)). N - copepod nauplii; E1 - copepodite stages I-III, E2 - copepodite stages IV-V; E3 - adult copepods. 
#e - E. affinis affinis; ea - E. affinis affinis & Acartia spp; l - L. macrurus macrurus. t - small cladocerans 
#e_N - E. affinis affinis mean abundance in May (copepod nauplii); e2_N - in August. 0 indicates previous year data (shifted by one year). 

idx = which(w$year %in% c(1961:2020))
w = w[idx,]
dat = w
#############################################################################
#Sliding window analysis figures
#Includes the variables that were significant in the GAM analysis with forward selection that affect ages 2-5 the mean annual growth. 
##############################################################################
#Figrue 1
#Results of the chronological sliding window analysis: time trends in linear slopes of mean annual growth (g) age-2 with a) L. macrurus macrurus abundance (ln(ind. m-2)) in August (adult copepods), and b) E. affinis affinis previous year abundance (ln(ind. m-2)) in May (copepodite stage I-III). Filled points donate values, where the slope was significant at p<0.05. Grey line is the mean values of the respective variable in each 15-year subset (1961-1975, 1962-1976,..., 2006-2020). On the x-axis is the middle year of each 15-year subset.

set = subset(dat, select = c("year","x1", "l2_E3", "e_E20"))
summary(gam(x1 ~ s(l2_E3, k = 4) + s(e_E20, k = 4), data = dat))

cor1 = rep(NA,44) # Here will be slope of age-2 mean annual growth vs Limnocalanus abundance 
cor2 = rep(NA,44) # Here will be slope of age-2 mean annual growth vs E. affinis affinis
p1 = rep(NA,44) # Limnocalanus slope p values
p2 = rep(NA,44) # E. affinis affinis slope p values
mean_l2_E3 = rep(NA,44)
mean_e_E20 = rep(NA,44)
mean_x1 = rep(NA, 44)
years = c(1961:2020)
cy = rep(NA, 44)

for(i in 1:46){
  year = c((1961+i):(1961+i+14))	
  idx = which(set$year %in% year)
  m1 = data.frame(summary(lm(x1 ~ l2_E3, data = set[idx,]))$coef)
  cor1[i] = m1[2,1]
  p1[i] = m1[2,4]
  m2 = data.frame(summary(lm(x1 ~ e_E20, data = set[idx,]))$coef)
  cor2[i] = m2[2,1]
  p2 = m2[2,4]
  mean_l2_E3[i]<-mean(set$l2_E3[idx])
  mean_e_E20[i]<-mean(set$e_E20[idx])
  cy[i] = round(mean(year),digits=0)
}

par(mfrow = c(1, 2), tck=-0.02, mar=c(2.7,2.7,2,2.5), mgp = c(1.3,0.3,0), cex.axis = 1.1, cex.lab = 1.1)
plot(cor1 ~ cy, ylab = "Linear model slope", xlab="Year", pch = 1, xlim = c(1965,2015))
lines(cor1 ~ cy)
points(cor1 ~ cy, col = rgb(1,1,1), pch = 16, cex = .9)
idx = which(p1 < 0.05)
points(cor1[idx] ~ cy[idx],  pch = 16)

abline(h = 0)
abline(v = c(1970,1980,1990,2000,2010), lwd =.5, col = rgb(0,0,0,alpha = 0.5))
par(new = T)
plot(mean_l2_E3 ~ cy, axes = F, type = "n", ylab = "", xlab = "", xlim = c(1965,2015))
lines(mean_l2_E3 ~ cy, col = grey(0.5), lwd = 2)
axis(4)
mtext("Mean abund. of the window", side = 4, line = 1.3, cex = 1, col = grey(0.5))
mtext("a) Effect of L. macrurus macrurus (August, adult).", side = 3, adj = 0, cex = 1, line = 0.2)

plot(cor2 ~ cy, ylab = "Linear model slope", xlab = "Year", pch = 1, xlim = c(1965,2015))
lines(cor2 ~ cy)
points(cor2~ cy, col = rgb(1,1,1), pch = 16, cex = .9)
idx = which(p2 < 0.05)
points(cor2[idx] ~ cy[idx],  pch = 16)
